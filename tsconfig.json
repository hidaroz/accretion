{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  // Tests are not part of the shipped build, and compiling them made vitest
  // collect every suite twice — once from src/, once from dist/ — so `npm test`
  // was half-running stale compiled copies of itself.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
