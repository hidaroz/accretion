# --- accretion config (copy to .env) ---

# Auth: every /mcp request must send `Authorization: Bearer <API_KEY>`.
# Generate one, e.g.:  openssl rand -hex 32
API_KEY=your-secret-api-key-here

# Vault registry (preferred, multi-vault). Path to a JSON file:
#   { "vaults": [ { "id": "work", "path": "/abs/path", "displayName": "Work", "default": true } ] }
# Create/manage it with: node scripts/setup-vault.mjs --id <name> --path <abs> --default
VAULTS_CONFIG=~/.config/accretion/vaults.json

# Legacy single-vault mode (used only if VAULTS_CONFIG is unset):
# VAULT_PATH=./vault

# Server bind. Default is localhost-only; set 0.0.0.0 only to expose intentionally (e.g. Docker).
HOST=127.0.0.1
PORT=3001

# Optional: skip the local embedding model entirely (keyword + routing only).
# DISABLE_EMBEDDINGS=1
# Optional: where transformers.js caches model weights (defaults to OS cache dir).
# TRANSFORMERS_CACHE=~/.cache/huggingface
