# --- accretion environment (all optional) ---
# The CLI, hooks and MCP adapter read these from the environment; there is no
# server and nothing to listen on. Set them in your shell profile, or in the
# launchd plists for the scheduled pieces.

# Vault registry. Default: ~/.config/accretion/vaults.json (the legacy
# ~/.config/obsidian-mcp/vaults.json is read with a warning). A leading ~ is expanded.
# VAULTS_CONFIG=~/.config/accretion/vaults.json

# Project → vault map used by the capture and recall hooks.
# Default: ~/.claude/hooks/project-vault-map.json
# PROJECT_VAULT_MAP=~/.claude/hooks/project-vault-map.json

# The accretion checkout, for hooks and wrappers that were copied elsewhere.
# Default: derived from the running file's location.
# ACCRETION_HOME=~/devprojects/accretion

# Skip the local embedding model everywhere (keyword + routing only). Per-vault
# control is `semantic` in vaults.json.
# DISABLE_EMBEDDINGS=1

# Where transformers.js caches model weights (defaults to its own cache dir).
# TRANSFORMERS_CACHE=~/.cache/huggingface

# Sentence-embedding model, or a vendored model directory for offline machines.
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# error (default for the CLI and hooks) | warn | info | debug
# LOG_LEVEL=error
