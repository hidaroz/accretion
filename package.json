{
  "name": "accretion",
  "version": "0.2.0",
  "description": "Curated agent memory over Obsidian vaults: an engine and the accretion CLI, with a Claude Code plugin (skills, capture and passive-recall hooks) and a stdio MCP adapter.",
  "type": "module",
  "main": "dist/engine/index.js",
  "author": "Hidar Elhassan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hidaroz/accretion.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "accretion": "dist/cli/main.js",
    "accretion-mcp": "dist/mcp/main.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node scripts/build-hooks.mjs",
    "start": "node dist/cli/main.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "node scripts/doctor.mjs",
    "bootstrap": "node scripts/bootstrap.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "gray-matter": "^4.0.3",
    "minisearch": "^7.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.4",
    "typescript": "^5.8.0",
    "vitest": "^4.1.7"
  }
}
